@page "/"
@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager

<PageTitle>Home</PageTitle>

<h1>Hello, world!</h1>

<AuthorizeView>
    <Authorized>
        You have been authorized!
    </Authorized>
    <NotAuthorized>
        Please Login <span style="cursor: pointer; color: dodgerblue;" @onclick="@(() => NavigationManager.NavigateTo("/Login", true))">here</span>
    </NotAuthorized>
</AuthorizeView>
