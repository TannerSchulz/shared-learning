@page "/register"
@using FLP.Client.Services.Profile
@using FLP.Client.Services.UserAccount
@inject IUserAccountService UserAccountService
@inject NavigationManager NavigationManager


<div style="text-align: center; display: flex; justify-content: center; align-items: center;">
    <div style="width: fit-content; padding: 12px; background-color: rgb(204, 213, 174);">
        <div>
            <h3>Register New User</h3>
            <p style="color: red;">@ErrorMessage</p>
        </div>
        <div style="text-align: left;">
            <EditForm Model="registerUser" OnValidSubmit="HandleValidRegister">
                <DataAnnotationsValidator />
                <div>
                    <label>Email: </label>
                    <InputText style="float: right;" @bind-Value="registerUser.email"></InputText>
                    <br style="clear: both;" />
                    <ValidationMessage For="() => registerUser.email" />
                </div>
                <div>
                    <label>Password: </label>
                    <InputText type="password" style="float: right;" @bind-Value="registerUser.password"></InputText>
                    <br style="clear: both;" />
                    <ValidationMessage For="() => registerUser.password" />
                </div>
                <div>
                    <label>Confirm Password: </label>
                    <InputText type="password" style="float: right;" @bind-Value="registerUser.confirmPassword"></InputText>
                    <br style="clear: both;" />
                    <ValidationMessage For="() => registerUser.confirmPassword" />
                </div>
                <br style="clear: both;" />
                <button type="submit">Register</button>
            </EditForm>
        </div>
    </div>
</div>

@code {
    string ErrorMessage;
    RegisterModel registerUser = new RegisterModel();

    public async void HandleValidRegister()
    {
        var status = await UserAccountService.Register(registerUser);
        if(status.Code != "200")
        {
            ErrorMessage = status.Message;
        }
        else
        {
            NavigationManager.NavigateTo("/Login");
        }
    }
}